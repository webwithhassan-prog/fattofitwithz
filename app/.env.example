# Copy this file to .env.local and fill in the values.  NEVER commit .env.local.

# Public URL of the site (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (TEST MODE) -------------------------------------------------------
# https://dashboard.stripe.com/test/apikeys  -> "Secret key" (starts with sk_test_)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
# Safety switch: live keys (sk_live_) are refused unless this is "true"
ALLOW_LIVE_PAYMENTS=false

# --- Email (optional while developing) ---------------------------------------
# https://resend.com/api-keys . Without it, emails are printed in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM="Fat To Fit With Z <onboarding@resend.dev>"

# --- Database + admin panel (Payload CMS) ------------------------------------
# Neon Postgres connection string (Neon dashboard > Connect, "Connection pooling" ON)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Long random string used to sign logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Admin dashboard visit counting -------------------------------------------
# Visits are counted only on the live site. Set to true to count them while developing.
STATS_IN_DEV=false
# How often counted visits are saved to the database (minutes). Lower = fresher, more database use.
STATS_FLUSH_MINUTES=60
